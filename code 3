class MyThread extends Thread{
    public void run()
    {
        try
        {
        for(int i=0;i<=5;i++){
            System.out.println("Thread is running ");
            Thread.sleep(1000);
        }
    }
    catch(InterruptedException e)
    {
System.out.println(e);
    }
}
    
        
}
public class multithreading {
    public static void main(String[] args) {
        MyThread t1 = new MyThread();
        t1.start();
        t1.interrupt();
    }
}
